<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#15181A">

    <com.pixlite.scannerproof.ZoomableImageView
        android:id="@+id/zoomImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

    <TextView
        android:id="@+id/dimensionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textColor="#ECEBE6"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:padding="8dp">

        <Button
            android:id="@+id/btnOriginal"
            style="@style/Widget.AppCompat.Button.Small"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Original"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnNatural"
            style="@style/Widget.AppCompat.Button.Small"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Natural"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnDocument"
            style="@style/Widget.AppCompat.Button.Small"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Document"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnBw"
            style="@style/Widget.AppCompat.Button.Small"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="B&amp;W"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <TextView
            android:id="@+id/timingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#A7ADAA"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </ScrollView>

    <Button
        android:id="@+id/shareButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Share current result" />
</LinearLayout>
